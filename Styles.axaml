<!--
  Shared style classes — the one place to add a reusable visual pattern once it
  shows up more than once across views. Companion to Tokens.axaml: this file
  bundles combinations of token-driven setters that were previously repeated
  inline in each view; it doesn't introduce any new colors/sizes of its own.

  Merged into Application.Styles (see App.axaml) after FluentTheme, so these
  classes are available to every view without each one needing its own
  Window.Styles/UserControl.Styles copy.

  Kept deliberately small: only patterns that actually repeated across two or
  more views were promoted here. View-specific state styles (e.g. MatchView's
  .duplicate/.exactMatch/.shadeA/.shadeB match-result markers) stay local to
  that view since they're semantically specific to it, not shared vocabulary.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Scoped variant of Fluent's own MenuItem ControlTheme (ControlThemes belong in
             Resources, not Styles — see avalonia-styling skill), used only by the
             "Ignore Folder" MenuItem in MatchView/ReportView's context menus
             (Theme="{StaticResource BottomSubmenuMenuItemTheme}"). Fluent's own theme
             hardcodes its submenu Popup to Placement="RightEdgeAlignedTop" — there's no
             plain property to redirect that, the popup is only reachable by re-supplying
             the whole ControlTemplate. BasedOn the real theme so every other Setter/Style
             (colors, pointer-over, disabled, chevron, etc.) still applies unchanged; only
             the Template itself (and, within it, only the Popup's Placement/
             HorizontalOffset) actually differs from Fluent's original — see
             https://github.com/AvaloniaUI/Avalonia src/Avalonia.Themes.Fluent/Controls/MenuItem.xaml
             for the upstream source this was copied from. -->
        <ControlTheme x:Key="BottomSubmenuMenuItemTheme" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="PART_LayoutRoot"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToggleIcon" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIcon" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGT" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemChevron" />
                                </Grid.ColumnDefinitions>

                                <ContentControl Grid.Column="0"
                                                x:Name="PART_ToggleIconPresenter"
                                                IsVisible="False"
                                                Theme="{StaticResource FluentMenuItemIconTheme}"
                                                Margin="{DynamicResource MenuIconPresenterMargin}" />

                                <ContentControl Grid.Column="1"
                                                x:Name="PART_IconPresenter"
                                                IsVisible="False"
                                                Theme="{StaticResource FluentMenuItemIconTheme}"
                                                Content="{TemplateBinding Icon}"
                                                Margin="{DynamicResource MenuIconPresenterMargin}" />

                                <ContentPresenter Name="PART_HeaderPresenter"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  Grid.Column="2" />
                                <TextBlock x:Name="PART_InputGestureText"
                                           Grid.Column="3"
                                           Margin="{DynamicResource MenuInputGestureTextMargin}"
                                           Text="{TemplateBinding InputGesture, Converter={StaticResource KeyGestureConverter}}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}" />
                                <Path Name="PART_ChevronPath"
                                      Stretch="Uniform"
                                      Width="8"
                                      Height="16"
                                      Data="{StaticResource MenuItemChevronPathData}"
                                      Fill="{DynamicResource MenuFlyoutSubItemChevron}"
                                      Margin="{DynamicResource MenuFlyoutItemChevronMargin}"
                                      VerticalAlignment="Center"
                                      Grid.Column="4" />
                            </Grid>
                        </Border>
                        <!-- The only real change from Fluent's original: Placement="Bottom"
                             (centers the submenu horizontally under this item and grows it
                             downward) instead of "RightEdgeAlignedTop", and no
                             HorizontalOffset — that -4px nudge existed to tuck a
                             side-opening submenu snugly against its parent, which doesn't
                             apply once it's centered underneath instead. -->
                        <Popup Name="PART_Popup"
                               WindowManagerAddShadowHint="False"
                               Placement="Bottom"
                               IsLightDismissEnabled="False"
                               IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
                            <!-- No MaxWidth here (Fluent's original binds
                                 FlyoutThemeMaxWidth, a fixed cap around ~450px) — a deep
                                 folder path easily exceeds that, and the user explicitly
                                 wants this sized to the full text, not truncated/wrapped
                                 at a fixed width. -->
                            <Border Background="{DynamicResource MenuFlyoutPresenterBackground}"
                                    BorderBrush="{DynamicResource MenuFlyoutPresenterBorderBrush}"
                                    BorderThickness="{DynamicResource MenuFlyoutPresenterBorderThemeThickness}"
                                    Padding="{DynamicResource MenuFlyoutPresenterThemePadding}"
                                    MinHeight="{DynamicResource MenuFlyoutThemeMinHeight}"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="{DynamicResource OverlayCornerRadius}">
                                <ScrollViewer Theme="{StaticResource FluentMenuScrollViewer}">
                                    <ItemsPresenter Name="PART_ItemsPresenter"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    Margin="{DynamicResource MenuFlyoutScrollerMargin}"
                                                    Grid.IsSharedSizeScope="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- Explicit Window background/foreground rather than relying on Fluent's own
         Dark-variant defaults, so the exact retro palette in Tokens.axaml (not
         Fluent's approximation of "dark") is what actually renders. Foreground is
         an inherited property, so this also covers every TextBlock/label that
         doesn't set its own — which is most of them. -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>

    <!-- Fixed (not Min) height — DropDownButton's own template reserves extra
         internal room for its chevron/split-button chrome, so it's naturally
         taller than a plain Button even at the same MinHeight; only an explicit
         Height forces every toolbar button (MatchView's Start/Cancel/Selection/
         Collapse All/Rename Selected row, ReportView's Refresh/Export) to match.
         Padding drops its vertical component (Fluent's own default is a slightly
         asymmetric 12,5,12,6, which reads fine at a natural height but visibly
         off-center once Height is fixed) so VerticalContentAlignment="Center" is
         what actually centers the label within the fixed 32px, the same way
         DropDownButton's own template already centers its content+chevron. -->
    <Style Selector="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Sidebar vocabulary, shared by MainWindow's app sidebar and the Options pane's
         own nav so the two read as one design. .sidebarSection is the muted
         "SOURCES"/"FILTERS" heading; .fieldLabel the small caption above a sidebar
         field; Button.nav a flat, full-width, left-aligned row (Discord-channel-list
         style rather than Fluent's raised chrome), with .active marking the current
         page by the page-background colour plus accent text. -->
    <Style Selector="TextBlock.sidebarSection">
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <!-- Active row takes the page background, so it reads as a tab joined to the page it
         opens. Not BorderBrush (the original choice): borders are deliberately mid-tone,
         and accent text on them fell below 4.5:1 in most themes (3.2 in Handheld), where
         accent on the page background is checked per theme and passes everywhere. -->
    <Style Selector="Button.nav.active">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Square, chrome-less icon button — the sidebar's ☰ toggle, MatchView's
         Expand/Collapse All and rename-notice dismiss. Fluent's own pointer-over
         background still shows, so it reads as clickable on hover. -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- ===== Text roles =====
         Every piece of text is one of these (plus the default Body: Share Tech at Fluent's
         14, which buttons, nav rows, toggles and inputs get without a class). Change a
         role here, not per view. Case: sentence case everywhere; section headings are
         written in capitals in the markup (Avalonia has no text-transform). -->

    <!-- Page title — the page name in the title strip, Options page titles. -->
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
    </Style>

    <!-- Section heading — SOURCES, FILTERS, the Options pane's own header, headings
         inside an Options page. Muted so it groups without shouting. -->
    <Style Selector="TextBlock.sectionHeading">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>

    <!-- Brand — the app's name and version, the noclip caption: pixel type at heading
         size, but full-strength colour. -->
    <Style Selector="TextBlock.brand">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
    </Style>

    <!-- Data — filenames, paths, scores, counts, folder names in inputs. -->
    <Style Selector="TextBlock.data">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyData}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
    <!-- Separate style, not "TextBlock.data, TextBox.data": the two share no base type
         that declares FontFamily, so a combined selector can't resolve the setter. -->
    <Style Selector="TextBox.data">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyData}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <!-- Label — field labels, column headers, short status lines. Quieter than the
         data it labels. -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>

    <!-- Caption — explanatory sentences: hints, descriptions, empty states. Wraps. -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Muted — colour only, for secondary bits inside another role (e.g. a data
         count, "· Same as above"). -->
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    </Style>

</Styles>
