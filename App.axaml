<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameArtMatch.App"
             xmlns:local="using:GameArtMatch"
             RequestedThemeVariant="Dark">
             <!-- Pinned to Dark for the retro theme (see Tokens.axaml) rather than "Default"
                  (follow OS theme) — Fluent's own built-in control chrome (TextBox/ComboBox/
                  ScrollBar/MenuFlyout backgrounds, etc.) comes from FluentTheme's own Light/Dark
                  dictionaries, not from our tokens, so this app is dark-only right now, not
                  theme-variant-aware. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- Shared style classes (see Styles.axaml) — after FluentTheme so they
             can override its defaults where a class sets a property. -->
        <StyleInclude Source="avares://GameArtMatch/Styles.axaml" />
    </Application.Styles>

    <!-- Merged after FluentTheme (above) so our design tokens take precedence over
         Fluent's own defaults app-wide — see Tokens.axaml, the single place to edit
         the app's look. Application.Resources resolves ahead of resources merely
         contributed by a Styles entry like FluentTheme, regardless of declaration
         order, but this is placed textually after it to read the same way. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GameArtMatch/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>