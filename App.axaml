<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameArtMatch.App"
             xmlns:local="using:GameArtMatch"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- Merged after FluentTheme (above) so our design tokens take precedence over
         Fluent's own defaults app-wide — see Tokens.axaml, the single place to edit
         the app's look. Application.Resources resolves ahead of resources merely
         contributed by a Styles entry like FluentTheme, regardless of declaration
         order, but this is placed textually after it to read the same way. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GameArtMatch/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>