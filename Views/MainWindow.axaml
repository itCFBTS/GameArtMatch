<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameArtMatch.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="700"
        x:Class="GameArtMatch.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="GameArtMatch"
        Width="1060" Height="700" MinWidth="720" MinHeight="480">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- The menu bar's replacement for keyboard access (Alt+F-style mnemonics went with
         it). Ctrl+Q (exit) is added from code-behind — it's a window action, not a
         ViewModel command. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding MatchVm.ToggleStartCancelCommand}" />
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding MatchVm.RenameFilesCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding MatchVm.ToggleExpandCollapseCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenOptionsCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Small-caps-ish section heading inside the sidebar ("SOURCES", "FILTERS"). -->
        <Style Selector="TextBlock.sidebarSection">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Flat, full-width, left-aligned sidebar rows (Match / Report / Options) —
             Discord-channel-list style rather than Fluent's raised button chrome. The
             active page gets the Surface-on-Surface highlight plus the accent text. -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Window.Styles>

    <!-- Sidebar in the order the app is actually used, top to bottom: pick folders ->
         scan -> filter; the rename step lives at the foot of the Match page itself (see
         MatchView). Replaces the old File/Select/View/Help menu bar and the ROMs/Images
         toolbar. CompactInline + a 48px compact length leaves just the ☰ button visible
         when collapsed (Ctrl+B); every other section hides itself outright rather than
         showing a clipped 48px sliver of its controls. -->
    <SplitView IsPaneOpen="{Binding IsSidebarOpen}" DisplayMode="CompactInline"
               OpenPaneLength="236" CompactPaneLength="48"
               PaneBackground="{DynamicResource SurfaceBrush}">
        <SplitView.Pane>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="8,8,8,0">
                    <Button DockPanel.Dock="Left" Classes="icon" Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="Toggle sidebar (Ctrl+B)">
                        <PathIcon Width="16" Height="16"
                                  Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" />
                    </Button>
                    <TextBlock Text="GameArtMatch" Classes="retroLabel" VerticalAlignment="Center"
                               Margin="8,0,0,0" IsVisible="{Binding IsSidebarOpen}" />
                </DockPanel>

                <!-- Footer: Options (About and Open Settings Folder live inside it now). -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="8" IsVisible="{Binding IsSidebarOpen}">
                    <Button Classes="nav" Content="Options" Command="{Binding OpenOptionsCommand}"
                            ToolTip.Tip="Options (Ctrl+,)" />
                </Border>

                <ScrollViewer IsVisible="{Binding IsSidebarOpen}" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,12,12,12">
                        <Button Classes="nav" Classes.active="{Binding IsMatchPageActive}"
                                Content="Match" Command="{Binding ShowMatchPageCommand}" />
                        <Button Classes="nav" Classes.active="{Binding IsReportPageActive}"
                                Content="Report" Command="{Binding ShowReportPageCommand}" Margin="0,2,0,0" />

                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="SOURCES" Classes="sidebarSection" />

                            <TextBlock Text="ROMs" Classes="fieldLabel" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SpaceXs}">
                                <TextBox Text="{Binding Settings.RomsPathDisplayName}" IsReadOnly="True"
                                         ToolTip.Tip="{Binding Settings.RomsPath}" />
                                <Button Grid.Column="1" Content="..." Click="OnBrowseRomsClick" Padding="8,0" />
                            </Grid>

                            <TextBlock Text="Images" Classes="fieldLabel" Margin="0,10,0,4" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SpaceXs}">
                                <TextBox Text="{Binding Settings.ImagesPathDisplayName}" IsReadOnly="True"
                                         ToolTip.Tip="{Binding Settings.ImagesPath}" />
                                <Button Grid.Column="1" Content="..." Click="OnBrowseImagesClick" Padding="8,0" />
                            </Grid>

                            <Button Classes="accent" Content="{Binding MatchVm.StartCancelButtonText}"
                                    Command="{Binding MatchVm.ToggleStartCancelCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Margin="0,14,0,0" ToolTip.Tip="F5" />

                            <!-- Post-scan display filters — hide/show already-computed rows,
                                 don't re-run matching (see MatchViewModel.ApplyFilters). File
                                 type only ever restricts ROMs; region restricts both ROMs and
                                 images, except English Translated, which always shows every
                                 image (see RegionFilter.Matches). Plain ComboBoxes over the
                                 scan-dependent AvailableFileTypes/AvailableRegions lists — the
                                 old View-menu radio submenus needed click/submenu-opened
                                 handlers to fake the same thing. Disabled until a scan has
                                 produced something to filter. -->
                            <StackPanel IsEnabled="{Binding MatchVm.HasResults}">
                                <TextBlock Text="FILTERS" Classes="sidebarSection" />

                                <TextBlock Text="File type" Classes="fieldLabel" />
                                <ComboBox ItemsSource="{Binding MatchVm.AvailableFileTypes}"
                                          SelectedItem="{Binding MatchVm.SelectedFileType, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Text="Region" Classes="fieldLabel" Margin="0,10,0,4" />
                                <ComboBox ItemsSource="{Binding MatchVm.AvailableRegions}"
                                          SelectedItem="{Binding MatchVm.SelectedRegion, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                    <TextBlock Text="Exact score only" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0"
                                                  IsChecked="{Binding MatchVm.ShowOnlyExactScoreMatches, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Hide same images" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0"
                                                  IsChecked="{Binding MatchVm.HideSameImages, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </SplitView.Pane>

        <!-- Both pages stay alive and just swap visibility (see MainViewModel.
             IsReportPageActive) — swapping Content would have ViewLocator build a fresh
             MatchView, re-realizing the whole results tree, on every page flip. -->
        <Panel>
            <ContentControl Content="{Binding MatchVm}" IsVisible="{Binding IsMatchPageActive}" />
            <ContentControl Content="{Binding ReportVm}" IsVisible="{Binding IsReportPageActive}" />
        </Panel>
    </SplitView>
</Window>
