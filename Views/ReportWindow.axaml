<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameArtMatch.ViewModels"
        xmlns:views="using:GameArtMatch.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
        x:Class="GameArtMatch.Views.ReportWindow"
        x:DataType="vm:ReportViewModel"
        Title="Report"
        Width="640" Height="520" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:ReportViewModel />
    </Design.DataContext>

    <views:ReportView />
</Window>
