<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameArtMatch.ViewModels"
             xmlns:model="using:GameArtMatch.Models"
             xmlns:behaviors="using:GameArtMatch.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="GameArtMatch.Views.ReportView"
             x:DataType="vm:ReportViewModel">

    <Design.DataContext>
        <vm:ReportViewModel />
    </Design.DataContext>

    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <Button Content="Export..." Click="OnExportClick" IsEnabled="{Binding IsListVisible}" />
        </DockPanel>

        <!-- Reflects whatever the Match page's last scan found — not re-scanned here; it
             follows MatchViewModel.MissingRoms live (see ReportViewModel), so there's no
             Refresh button. -->
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Classes="caption"
                   Text="ROMs the last scan on the Match page found no art for." />

        <!-- Matched was dropped — Missing is the only list left, so (matching
             MainWindow's own single-tab precedent) there's no TabControl anymore, just
             the list directly. SelectionMode="Multiple" enables ctrl/shift-click
             natively; Ctrl+A (custom, see ReportView.axaml.cs — ListBox has no built-in
             "select all") selects everything currently in the list. Right-clicking a row
             that's part of the current selection acts on the whole selection;
             right-clicking one that isn't acts on just that row — same convention as the
             Match tab's ROM context menu. -->
        <Panel>
            <!-- No scan yet / nothing missing / scan in progress — the list's stale contents
                 are hidden while a scan runs rather than passed off as current. -->
            <TextBlock Text="{Binding EmptyStateText}" Classes="caption" FontSize="{DynamicResource FontSizeBody}"
                       TextAlignment="Center" MaxWidth="360"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsEmptyStateVisible}" />

            <ListBox Name="MissingList" ItemsSource="{Binding Missing}" SelectionMode="Multiple"
                     IsVisible="{Binding IsListVisible}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="model:ReportEntry">
                        <Grid>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="Open file path" Click="OnOpenFilePathFromMissingClick" />
                                    <MenuItem Header="Ignore selected ROM(s)" Click="OnIgnoreFromMissingClick" />
                                    <!-- Same shape as MatchView.axaml's ROM row: sub-items come
                                         from IgnorableAncestorFolders, BottomSubmenuMenuItemTheme
                                         (see Styles.axaml) opens this submenu centered below
                                         rather than Fluent's default side placement, and one
                                         handler catches Click bubbling up from whichever
                                         auto-generated child was actually clicked (see
                                         OnIgnoreFolderFromMissingClick, which reads e.Source, not
                                         sender). -->
                                    <MenuItem Header="Ignore folder" Click="OnIgnoreFolderFromMissingClick"
                                              Theme="{StaticResource BottomSubmenuMenuItemTheme}"
                                              ItemsSource="{Binding IgnorableAncestorFolders}"
                                              IsEnabled="{Binding HasIgnorableAncestorFolders}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Border ClipToBounds="True" Height="20">
                                <Canvas>
                                    <TextBlock Text="{Binding RomFileName}" Classes="data" behaviors:MarqueeOnHoverBehavior.IsEnabled="True" />
                                </Canvas>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Panel>
    </DockPanel>
</UserControl>
