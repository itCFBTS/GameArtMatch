<!--
  Design tokens — this is the single place to edit to change GameArtMatch's look.
  Merged into App.axaml AFTER FluentTheme, so every value here overrides Fluent's
  own default app-wide. Views should reference these via DynamicResource, never
  hardcode a color/size directly, so a future look-and-feel pass only ever touches
  this one file.

  Color/brush tokens live under ThemeDictionaries (Light/Dark) since that's where
  Fluent expects theme-variant-dependent values. Spacing, corner radius, and font
  tokens are plain top-level entries since those don't vary by theme.

  SNES/NES-inspired retro pass, dark-only by design: App.axaml now pins
  RequestedThemeVariant="Dark" explicitly (rather than following the OS), because
  Fluent's own built-in control chrome — TextBox/ComboBox/ScrollBar/MenuFlyout
  backgrounds, etc. — comes from FluentTheme's own Light/Dark dictionaries, not
  from tokens here. Leaving RequestedThemeVariant="Default" would mean those
  native pieces silently flip to Fluent's Light palette on a light-mode OS while
  everything below stays dark, which would look broken rather than intentional.
  The Light dictionary is kept identical to Dark (not deleted) purely so nothing
  breaks if a variant toggle is ever added back later — it's not meant to be
  reached today.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Neutral warm-dark background, deliberately not a near-black/navy
                 "CRT screen" — closer to Obsidian/Claude Desktop's dark canvas, so
                 the SNES/NES-referencing accent colors below are what reads as
                 "retro," not the background itself. -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#FF1E1E1C" />
            <!-- One step lighter than BackgroundBrush — panel/row surfaces (tree
                 rows, preview pane) so they read as a distinct layer above the
                 window background. -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FF262420" />
            <SolidColorBrush x:Key="ForegroundBrush" Color="#FFE8E6E3" />
            <SolidColorBrush x:Key="ForegroundMutedBrush" Color="#FF8C8A85" />
            <SolidColorBrush x:Key="BorderBrush" Color="#FF3A3833" />

            <!-- SNES lavender-purple — primary accent (selection, exact-match
                 marker's usual role). No longer aliasing Fluent's SystemAccentColor:
                 that would follow the OS accent color, fighting the deliberate
                 retro palette rather than being part of it. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FFA78BFA" />
            <!-- Secondary accent, currently unused by any view but established
                 alongside AccentBrush for a future second highlight color (e.g. a
                 distinct "info" marker) without picking a one-off hex ad hoc. -->
            <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#FF4FD8EB" />

            <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF5C7A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFFFC94D" />

            <!-- Alternating row-background tints for clustering byte-identical candidate
                 images (see MatchCandidate.IsContentShadeA/B) — low-alpha overlays rather
                 than opaque colors, so the same value reads reasonably against the panel
                 surface without needing a separate hand-tuned hex. Kept as the existing
                 blue/purple pair (distinct hues from AccentBrush and WarningBrush so this
                 doesn't get read as either of those unrelated meanings) since they already
                 fit the palette. -->
            <SolidColorBrush x:Key="ContentGroupShadeABrush" Color="#222E9BF0" />
            <SolidColorBrush x:Key="ContentGroupShadeBBrush" Color="#228E44AD" />
        </ResourceDictionary>

        <!-- Identical to Dark — see file-level comment above. -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BackgroundBrush" Color="#FF1E1E1C" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FF262420" />
            <SolidColorBrush x:Key="ForegroundBrush" Color="#FFE8E6E3" />
            <SolidColorBrush x:Key="ForegroundMutedBrush" Color="#FF8C8A85" />
            <SolidColorBrush x:Key="BorderBrush" Color="#FF3A3833" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FFA78BFA" />
            <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#FF4FD8EB" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF5C7A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFFFC94D" />
            <SolidColorBrush x:Key="ContentGroupShadeABrush" Color="#222E9BF0" />
            <SolidColorBrush x:Key="ContentGroupShadeBBrush" Color="#228E44AD" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Variant-independent: shape/spacing/type don't change with light vs dark. -->

    <!-- Reverse-engineered from MatchView's preview-pane Border (CornerRadius="4"),
         the only CornerRadius literal in the app. -->
    <CornerRadius x:Key="CornerRadiusBase">4</CornerRadius>

    <!-- Reverse-engineered from every StackPanel.Spacing value already in use:
         6 (MainWindow's compact ROMs/Images sub-rows), 10 (all three OptionsWindow
         tab bodies), 12 (AboutWindow), 16 (MainWindow's outer picker row). -->
    <x:Double x:Key="SpaceXs">6</x:Double>
    <x:Double x:Key="SpaceSm">10</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>

    <!-- Body/list font — bundled directly (Assets/Fonts) rather than via a NuGet
         font package, so Program.cs's FontManagerOptions.DefaultFamilyName points
         at this same avares:// URI and it becomes the app's implicit default,
         matching how Avalonia.Fonts.Inter + WithInterFont() worked before. Share
         Tech Mono over a pixel/display font here since ROM/image filenames need
         to stay readable at small sizes, not just look retro. -->
    <FontFamily x:Key="FontFamilyBase">avares://GameArtMatch/Assets/Fonts#Share Tech Mono</FontFamily>

    <!-- Display/heading font — deliberately NOT the app-wide default. Used only
         where text is short (column headers, buttons, one-line labels): Press
         Start 2P's blocky glyphs get hard to read fast in longer strings, which
         is exactly what ROM/image filenames are. -->
    <FontFamily x:Key="FontFamilyDisplay">avares://GameArtMatch/Assets/Fonts#Press Start 2P</FontFamily>

    <!-- FontSizeSmall is reverse-engineered from every FontSize="12" literal in the
         app (all secondary/hint text). FontSizeDefault/Large aren't used by any
         current literal — the app relies on Fluent's inherited default everywhere
         else — but are declared now to establish the scale for future use. -->
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeDefault">13</x:Double>
    <x:Double x:Key="FontSizeLarge">16</x:Double>

    <!-- Smaller than FontSizeSmall on purpose: Press Start 2P's glyphs each fill a
         full monospace cell and read noticeably larger than a normal font at the
         same point size, so FontFamilyDisplay text needs a smaller size to sit
         proportionately next to FontFamilyBase text around it. -->
    <x:Double x:Key="FontSizeDisplay">11</x:Double>

</ResourceDictionary>
