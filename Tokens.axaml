<!--
  Design tokens that DON'T vary by theme — shape, spacing, sizes, fonts. Merged into
  App.axaml after FluentTheme, so these override Fluent's own defaults app-wide.
  Views reference them via DynamicResource, never a literal.

  Colours live in the theme files under Themes/ (one ResourceDictionary per theme,
  all defining the same keys), not here — ThemeService swaps the active one at
  runtime, and the Options pane's Appearance page picks it. See Themes/ThemeCatalog.cs.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- Reverse-engineered from MatchView's preview-pane Border (CornerRadius="4"),
         the only CornerRadius literal in the app. -->
    <CornerRadius x:Key="CornerRadiusBase">4</CornerRadius>
    <!-- Floating surfaces big enough that 4 reads as square — the Options pane card. -->
    <CornerRadius x:Key="CornerRadiusLarge">8</CornerRadius>

    <!-- Reverse-engineered from every StackPanel.Spacing value already in use:
         6 (the sidebar's picker rows), 10 (OptionsView's settings pages), 12 (the
         scan overlay, OptionsView's About page), 16 (spare). -->
    <x:Double x:Key="SpaceXs">6</x:Double>
    <x:Double x:Key="SpaceSm">10</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>

    <!-- Height of every bottom bar with a hairline on top — the app sidebar's Options
         footer, the Match page's Rename footer, and the Options pane's nav footer — so
         their dividers line up across the window. 1px hairline + 32px button + 10px
         above and below. -->
    <x:Double x:Key="FooterHeight">53</x:Double>

    <!-- Width of the drop shadow Avalonia draws around the borderless main window (see
         MainWindow's WindowDecorationsTheme) — Fluent's own default, pinned here because
         X11WindowHints also reports it to the window manager, and the two must agree
         or edge snapping lands off the visible border. -->
    <Thickness x:Key="WindowShadowThickness">8</Thickness>

    <!-- The sidebar's app glyph (MainWindow): a one-colour, Steam/Discord-style version
         of the app icon, in the icon's own cartridge-plastic grey on every theme. Theme-
         independent by choice; faint on the light themes (~1.7:1) — if that ever needs
         fixing, give each theme its own value (or an outline) instead. -->
    <SolidColorBrush x:Key="AppGlyphBrush" Color="#FF969DA4" />

    <!-- The noclip transition's caption card (MainWindow's NoclipOverlay). Fixed, not
         per-theme: the theme swaps underneath it mid-transition, and the card belongs to
         the Backrooms either way — Backrooms-22's darkest brown and palest yellow. -->
    <SolidColorBrush x:Key="BackroomsCardBrush" Color="#E62C211D" />
    <SolidColorBrush x:Key="BackroomsInkBrush" Color="#FFE9EAC0" />

    <!-- Three fonts, one job each (see the text roles in Styles.axaml):
         Interface — Share Tech (the app default via Program.cs): buttons, nav, labels,
           help text. The proportional sibling of the data font, so the two read as one
           family. Regular only — there's no bold, so never set FontWeight (it'd be faked).
         Data — Share Tech Mono: filenames, paths, scores, counts; monospace keeps them
           aligned and makes similar names easy to compare.
         Display — Press Start 2P: branding, page titles and section headings only. Its
           blocky glyphs get hard to read in longer strings, so never for body text. -->
    <FontFamily x:Key="FontFamilyUi">avares://GameArtMatch/Assets/Fonts#Share Tech</FontFamily>
    <FontFamily x:Key="FontFamilyData">avares://GameArtMatch/Assets/Fonts#Share Tech Mono</FontFamily>
    <FontFamily x:Key="FontFamilyDisplay">avares://GameArtMatch/Assets/Fonts#Press Start 2P</FontFamily>

    <!-- The type scale. Body is Fluent's own control size, so buttons and inputs match
         the text around them without overrides. -->
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeLarge">16</x:Double>

    <!-- Press Start 2P's glyphs fill a whole monospace cell and read larger than other
         fonts at the same size, so section headings use this smaller size to sit
         proportionately beside Body text. -->
    <x:Double x:Key="FontSizeDisplay">11</x:Double>

</ResourceDictionary>
